root   ::= object
value  ::= object | array | string | number | boolean | null

object ::=
  "{" ws (
            "\"risk_score\""      ws ":" ws number "," ws
            "\"severity\""        ws ":" ws severity_enum "," ws
            "\"rationale\""       ws ":" ws string "," ws
            "\"mitigation_steps\"" ws ":" ws string_list
  ) "}"

string_list   ::= "[" ws (string ("," ws string)*)? "]"
severity_enum ::= "\"critical\"" | "\"high\"" | "\"medium\"" | "\"low\"" | "\"informational\""

string  ::= "\""   ([^"]*)   "\""
boolean ::= "true" | "false"
ws      ::= [ \t\n]*
number  ::= [0-9]+