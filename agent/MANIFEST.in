include README.md
include LICENSE
include requirements.txt

# Recursively include data directories found in sources
recursive-include prompt_templates *.json
recursive-include knowledge *.json *.yaml
recursive-include executors *.py
recursive-include fixtures *.json *.yaml
recursive-include pypi_init *.py

# Ensure model configs and adapters are included if present
recursive-include sys_scan_agent/models *.json *.txt